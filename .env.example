# Banco (já configurado pelo docker-compose, sobrescreva se quiser usar outro)
DATABASE_URL=postgresql://postgres:postgres@db:5432/clubedaweb?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# AWS S3 (uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# OpenAI
OPENAI_API_KEY=

# Google Stitch (wizard — 5 páginas institucionais)
STITCH_API_KEY=
STITCH_PROJECT_ID=
STITCH_HTML_POLL_INTERVAL_MS=5000
STITCH_HTML_POLL_MAX_MS=90000
STITCH_USE_HOME_SAMPLE=1
STITCH_HOME_SAMPLE_MAX=800
STITCH_PROMPT_MAX_CHARS=4500
STITCH_EDIT_MAX_CHARS=120
STITCH_VARIANT_COUNT=2
# WIZARD_PAGE_PROVIDER=stitch|ai|template (padrão: stitch)
WIZARD_PAGE_PROVIDER=stitch

# SMTP / IMAP (nodemailer + imapflow)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
