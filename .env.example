# Banco (já configurado pelo docker-compose, sobrescreva se quiser usar outro)
DATABASE_URL=postgresql://postgres:postgres@db:5432/clubedaweb?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# AWS S3 (uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# OpenAI
OPENAI_API_KEY=

# SMTP / IMAP (nodemailer + imapflow)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
