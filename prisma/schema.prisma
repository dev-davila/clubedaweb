generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String
  role          String      @default("admin")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  auditLogs          AuditLog[]
  authorProfile      BlogAuthor?
  approvedPosts      BlogPost[]          @relation("PostApprover")
  blogPosts          BlogPost[]          @relation("PostCreator")
  posts              Post[]
  evolutionInstances EvolutionInstance[]
  waTags             WaTag[]
  waContacts         WaContact[]
  waScheduledContacts WaScheduledContact[]
  aiAgentConfigs      AiAgentConfig[]
  aiSessionsOwned     AiSession[]      @relation("AiSessionOwner")
  aiSessionsAssigned  AiSession[]      @relation("AiSessionAssignee")
  wizardSessions      WizardSession[]
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  imageUrl    String?
  category    String   @default("Tecnologia")
  author      String   @default("M3Solutions")
  status      String   @default("published")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  description String?
  website     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  showOnHome  Boolean  @default(true)
}

model BlogPost {
  id                    String              @id @default(cuid())
  title                 String
  slug                  String              @unique
  excerpt               String?
  content               String?
  contentHtml           String?
  metaTitle             String?
  metaDescription       String?
  keywords              String[]            @default([])
  featuredImage         String?
  imageAlt              String?
  status                PostStatus          @default(BRIEFING)
  publishedAt           DateTime?
  scheduledAt           DateTime?
  briefTitle            String?
  briefPersona          String?
  briefCta              String?
  briefKeywords         String[]            @default([])
  briefNotes            String?
  aiGenerated           Boolean             @default(false)
  aiModel               String?
  aiPromptUsed          String?
  aiGeneratedAt         DateTime?
  categoryId            String?
  authorId              String?
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  videoUrl              String?
  attendanceType        AttendanceType?
  brand                 String?
  geoCity               String?
  geoCountry            String?
  geoNeighborhood       String?
  geoState              String?
  mainKeyword           String?
  pageObjective         PageObjective?
  schemaMarkup          String?
  secondaryKeywords     String[]            @default([])
  seoBlockReason        String?
  seoBlocked            Boolean             @default(false)
  seoLevel              SeoLevel?
  seoLevelJustification String?
  seoRecommendedUrl     String?
  serviceType           String?
  secondaryImage        String?
  reviewToken           String?
  images                BlogImage[]
  approvedBy            User?               @relation("PostApprover", fields: [approvedById], references: [id])
  author                BlogAuthor?         @relation(fields: [authorId], references: [id])
  category              BlogCategory?       @relation(fields: [categoryId], references: [id])
  createdBy             User?               @relation("PostCreator", fields: [createdById], references: [id])
  tags                  BlogPostTag[]
  chronicle             Chronicle?
  socialPublications    SocialPublication[]

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([seoLevel])
  @@index([geoCity])
  @@index([deletedAt])

  viewCount             Int                 @default(0)
  deletedAt             DateTime?
  versions              PostVersion[]
}

model BlogCategory {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  image       String?
  color       String?              @default("#0066CC")
  order       Int                  @default(0)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  authors     BlogCategoryAuthor[]
  tags        BlogCategoryTag[]
  posts       BlogPost[]
  chronicles  Chronicle[]
}

model BlogTag {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  createdAt  DateTime          @default(now())
  authors    BlogAuthorTag[]
  categories BlogCategoryTag[]
  posts      BlogPostTag[]
}

model BlogCategoryAuthor {
  id         String       @id @default(cuid())
  categoryId String
  authorId   String
  author     BlogAuthor   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, authorId])
}

model BlogCategoryTag {
  id         String       @id @default(cuid())
  categoryId String
  tagId      String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag        BlogTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([categoryId, tagId])
}

model BlogAuthorTag {
  id       String     @id @default(cuid())
  authorId String
  tagId    String
  author   BlogAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tag      BlogTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([authorId, tagId])
}

model BlogPostTag {
  id     String   @id @default(cuid())
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

model BlogAuthor {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  bio                 String?
  avatar              String?
  email               String?
  linkedin            String?
  twitter             String?
  userId              String?              @unique
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  avoidTopics         String?
  contentGoals        String?
  keywords            String?
  promptTemplate      String?
  targetAudience      String?
  tone                String?
  writingStyle        String?
  wordCountMax        Int?
  wordCountMin        Int?
  videoAvatarDesc     String?
  videoAvatarName     String?
  videoAvatarStyle    String?
  videoBackground     String?
  videoCompanyMention String?
  videoCta            String?
  videoDuration       String?
  videoEnabled        Boolean              @default(false)
  videoIntroScript    String?
  videoOutroScript    String?
  videoTone           String?
  videoAvatarImage    String?
  user                User?                @relation(fields: [userId], references: [id])
  tags                BlogAuthorTag[]
  categories          BlogCategoryAuthor[]
  posts               BlogPost[]
  chronicles          Chronicle[]
}

model VoiceTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  persona     String
  tone        String?
  examples    String?
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogImage {
  id        String    @id @default(cuid())
  postId    String?
  filename  String
  path      String
  alt       String?
  caption   String?
  size      Int?
  mimeType  String?
  width     Int?
  height    Int?
  isFeature Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  post      BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model AIUsageLog {
  id           String   @id @default(cuid())
  model        String
  promptTokens Int
  outputTokens Int
  totalTokens  Int
  cost         Float?
  operation    String
  postId       String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AIPageModification {
  id              String   @id @default(cuid())
  pageId          String?
  pageTitle       String
  pageSlug        String
  action          String   // "edit" or "create"
  prompt          String
  referenceUrls   String?  // JSON array of external URLs
  referencePageIds String? // JSON array of internal page IDs
  previousContent String?  // JSON snapshot before change
  newContent      String?  // JSON snapshot after change
  status          String   @default("pending") // pending, applied, reverted
  provider        String?
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pageId])
  @@index([status])
  @@index([createdAt])
}

model AIQuota {
  id             String   @id @default(cuid())
  month          String   @unique
  tokensUsed     Int      @default(0)
  tokensLimit    Int      @default(1000000)
  postsGenerated Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  label       String?
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model CtaTemplate {
  id           String   @id @default(cuid())
  name         String
  text         String
  buttonText   String
  formId       String?
  linkUrl      String?
  whatsappText String?
  category     String   @default("general")
  icon         String?
  color        String?  @default("#7C3AED")
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}




model MediaLibrary {
  id            String   @id @default(cuid())
  filename      String
  url           String
  thumbnailUrl  String?
  alt           String?
  caption       String?
  category      String   @default("general")
  mimeType      String?
  size          Int?
  width         Int?
  height        Int?
  generatedByAI Boolean  @default(false)
  aiPrompt      String?
  aiProvider    String?
  tags          String[] @default([])
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([generatedByAI])
  @@index([createdAt])
}

model BrandTokens {
  id              String    @id @default(cuid())
  primaryColor    String    @default("#3B82F6")
  secondaryColor  String    @default("#1E40AF")
  accentColor     String    @default("#10B981")
  textColor       String    @default("#1F2937")
  textLightColor  String    @default("#6B7280")
  backgroundColor String    @default("#FFFFFF")
  surfaceColor    String    @default("#F9FAFB")
  fontPrimary     String    @default("Inter, sans-serif")
  fontSecondary   String    @default("Inter, sans-serif")
  fontHeading     String    @default("Inter, sans-serif")
  logoUrl         String?
  logoLightUrl    String?
  logoIconUrl     String?
  styleType       String    @default("corporate")
  borderRadius    String    @default("8px")
  buttonStyle     String    @default("rounded")
  iconStyle       String    @default("solid")
  lastAnalyzed    DateTime?
  analyzedFrom    String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SocialMediaAccount {
  id                 String              @id @default(cuid())
  platform           String              @unique
  accountName        String?
  accountId          String?
  profileUrl         String?
  profileImage       String?
  accessToken        String
  refreshToken       String?
  tokenType          String              @default("Bearer")
  scope              String?
  expiresAt          DateTime?
  refreshExpiresAt   DateTime?
  autoPost           Boolean             @default(true)
  postTemplate       String?
  hashtagsDefault    String[]            @default([])
  isConnected        Boolean             @default(true)
  lastUsedAt         DateTime?
  lastError          String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizationId     String?
  organizationName   String?
  postAsOrganization Boolean             @default(false)
  postAsBoth         Boolean             @default(false)
  publications       SocialPublication[]

  @@index([platform, isConnected])
}

model SocialPublication {
  id           String             @id @default(cuid())
  accountId    String
  blogPostId   String?
  platform     String
  postId       String?
  postUrl      String?
  content      String
  imageUrl     String?
  status       String             @default("pending")
  errorMessage String?
  likes        Int                @default(0)
  comments     Int                @default(0)
  shares       Int                @default(0)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  account      SocialMediaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blogPost     BlogPost?          @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  metrics      SocialMetric[]

  @@index([accountId])
  @@index([blogPostId])
  @@index([platform, status])
}

model SecurityEvent {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  ip             String
  userId         String?
  sessionId      String?
  eventType      String
  action         String
  reason         String
  method         String
  url            String
  userAgent      String?
  payloadExcerpt String?
  statusCode     Int?
  country        String?
  city           String?

  @@index([ip])
  @@index([eventType])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model SecurityBlock {
  id        String    @id @default(cuid())
  ip        String
  reason    String
  eventType String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  active    Boolean   @default(true)
  hitCount  Int       @default(1)
  createdBy String?

  @@index([ip])
  @@index([active])
  @@index([expiresAt])
}

model SecurityAllowlist {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdBy String?

  @@index([ip])
  @@index([active])
}

model SecuritySetting {
  id           String   @id @default(cuid())
  settingKey   String   @unique
  settingValue String
  description  String?
  updatedAt    DateTime @updatedAt

  @@index([settingKey])
}

model SecurityRateLimit {
  id           String   @id @default(cuid())
  ip           String
  endpoint     String
  windowStart  DateTime
  requestCount Int      @default(1)

  @@unique([ip, endpoint, windowStart])
  @@index([ip])
  @@index([windowStart])
}

model SecurityLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())
  userAgent String?

  @@index([ip])
  @@index([email])
  @@index([createdAt])
}

model MonitoredSite {
  id            String             @id @default(cuid())
  name          String
  url           String
  feedUrl       String?
  selector      String?
  active        Boolean            @default(true)
  checkInterval Int                @default(3)
  lastCheckedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  articles      CollectedArticle[]

  @@index([active])
  @@index([lastCheckedAt])
}

model CollectedArticle {
  id          String        @id @default(cuid())
  siteId      String
  title       String
  excerpt     String?
  originalUrl String        @unique
  imageUrl    String?
  publishedAt DateTime?
  collectedAt DateTime      @default(now())
  status      ArticleStatus @default(pending)
  notifiedAt  DateTime?
  selectedAt  DateTime?
  chronicle   Chronicle?
  site        MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([status])
  @@index([collectedAt])
  @@index([notifiedAt])
}

model ChronicleRecipient {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Chronicle {
  id               String           @id @default(cuid())
  articleId        String           @unique
  title            String
  content          String
  featuredImage    String?
  sourceReference  String
  status           ChronicleStatus  @default(draft)
  publishToSocial  Boolean          @default(false)
  socialPlatforms  String[]         @default([])
  categoryId       String?
  authorId         String?
  blogPostId       String?          @unique
  scheduledFor     DateTime?
  publishedAt      DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  facebookPostUrl  String?
  instagramPostUrl String?
  linkedinPostUrl  String?
  twitterPostUrl   String?
  article          CollectedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author           BlogAuthor?      @relation(fields: [authorId], references: [id])
  blogPost         BlogPost?        @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  category         BlogCategory?    @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([scheduledFor])
}

model SelectionToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

model ApprovalToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

